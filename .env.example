# Public HTTPS endpoint that receives contact enquiries as JSON via POST.
# Apps Script accepts the simple text/plain request used to avoid a CORS preflight.
# Leave empty to show the form's configuration notice.
VITE_CONTACT_ENDPOINT=https://script.google.com/macros/s/AKfycbzxaS-hplCfx9UpTM81U2ItnuJKm1pXzNKQMfKxmYeL7vV_bV6Vhzs92f2n1X8_1dub/exec

# Absolute public origin used at build time for sitemap.xml, robots.txt and social metadata.
# Do not include a trailing slash. Replace the placeholder before launch.
SITE_URL=https://your-domain.example
